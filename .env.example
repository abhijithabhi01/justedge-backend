# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# Local dev: mongodb://127.0.0.1:27017/hearth-admin
# MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/hearth-admin
# Later, on AWS: point this at DocumentDB or Atlas-on-AWS — nothing else in the
# app needs to change, since all Mongo access goes through src/config/db.js.
MONGO_URI=mongodb://127.0.0.1:27017/hearth-admin

# Long random strings in real environments — generate with `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed origins for the React app
CORS_ORIGIN=http://localhost:5173

# First Superadmin account, created by `npm run seed` if no admins exist yet
SEED_SUPERADMIN_NAME=Founder Admin
SEED_SUPERADMIN_EMAIL=admin@hearth.io
SEED_SUPERADMIN_PASSWORD=change-this-immediately
