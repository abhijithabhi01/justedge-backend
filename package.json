{
  "name": "justedge-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Node/Express + MongoDB API for the JustEdge superadmin dashboard (admin accounts, activity logs, access control, oversight). Designed to move behind AWS (EC2/ECS + DocumentDB or Atlas) later with no code changes — all infra is env-configured.",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed/seed.js",
    "seed:demo": "node src/seed/demo-seed.js",
    "simulate:gps": "node scripts/simulate-gps-board.js",
    "seed:gps": "node src/seed/seed-gps-device.js",
    "seed:demo-mongo": "node src/seed/seed-demo-mongo.js",
    "simulate:demo": "node scripts/demo-mongo-sensors.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1111.0",
    "@aws-sdk/lib-dynamodb": "^3.1111.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}